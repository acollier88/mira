# Mira configuration file
# Copy this to .mira.yaml in your repository root

llm:
  # Model identifier. Known OpenRouter models appear in the dashboard dropdown,
  # but any string is allowed when you point Mira at a custom OpenAI-compatible
  # endpoint such as Ollama, SGLang, or vLLM.
  model: "openai/gpt-4o"
  # Fallback model if primary fails
  fallback_model: "openai/gpt-4o-mini"
  # Base URL for an OpenAI-compatible chat-completions API.
  # OpenRouter default:
  base_url: "https://openrouter.ai/api/v1"
  # Environment variable containing the bearer token. Set to "" for local
  # endpoints that do not require auth.
  api_key_env: "OPENROUTER_API_KEY"
  temperature: 0.2
  max_tokens: 4096

filter:
  # Minimum confidence threshold (0.0 - 1.0)
  confidence_threshold: 0.7
  # Maximum number of comments to post
  max_comments: 5
  # Minimum severity level: blocker, warning, suggestion, nitpick
  min_severity: "nitpick"
  # Glob patterns for files to exclude
  exclude_patterns:
    - "*.lock"
    - "*.lockb"
    - "package-lock.json"
    - "yarn.lock"
    - "pnpm-lock.yaml"
    - "*.min.js"
    - "*.min.css"
    - "*.map"
    - "*.svg"
    - "*.png"
    - "*.jpg"
    - "*.gif"
  # Skip deleted files
  exclude_deleted: true
  # Maximum number of files to review
  max_files: 50

review:
  # Lines of context around hunks
  context_lines: 3
  # Maximum diff size in characters
  max_diff_size: 50000
  # Only flag critical problems/bugs (false = also suggest improvements)
  focus_only_on_problems: false
  # Include a summary comment
  include_summary: true
  # Generate a PR walkthrough comment (top-level summary)
  walkthrough: true
  # Include a Mermaid sequence diagram in the walkthrough
  walkthrough_sequence_diagram: true

# Examples:
#
# OpenRouter (default)
# llm:
#   model: "anthropic/claude-sonnet-4-6"
#   base_url: "https://openrouter.ai/api/v1"
#   api_key_env: "OPENROUTER_API_KEY"
#
# Ollama
# llm:
#   model: "llama3.1:70b"
#   base_url: "http://localhost:11434/v1"
#   api_key_env: ""
#
# SGLang
# llm:
#   model: "Qwen/Qwen3-Coder-30B-A3B-Instruct"
#   base_url: "http://localhost:30000/v1"
#   api_key_env: ""
